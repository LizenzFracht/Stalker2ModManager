{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S2MM",
  "version": "0.1.2",
  "identifier": "de.s2mm.stalker2modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "S2MM – Stalker 2 Mod Manager",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "dragDropEnabled": true,
        "backgroundColor": "#121311"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "**/S2MM-Daten/**",
          "**/S2MM-Data/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Mod manager for S.T.A.L.K.E.R. 2: Heart of Chornobyl",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ]
      }
    },
    "publisher": "S2MM contributors",
    "copyright": "MIT License – S2MM contributors",
    "homepage": "https://github.com/LizenzFracht/Stalker2ModManager",
    "category": "Game",
    "longDescription": "Install, sort and conflict-check mods for S.T.A.L.K.E.R. 2, edit MCM settings and key bindings, tweak Engine.ini and follow your position on a live map. Unofficial fan project, not affiliated with GSC Game World.",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "section": "games"
      }
    }
  }
}
